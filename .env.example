# Server-only — used by /api/portfolio and /api/activity
ALCHEMY_API_KEY=

# Client RPC (can be the same Alchemy key; restrict by domain in Alchemy dashboard)
NEXT_PUBLIC_ALCHEMY_API_KEY=

# RainbowKit / WalletConnect Cloud project ID
# https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Dapp origin shown to wallets (MetaMask SDK needs a real URL; defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
